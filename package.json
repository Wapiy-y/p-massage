{
  "name": "p-massage",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first feedback site for an independent massage therapist — Cloudflare Worker, Hono, D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 execute massage-feedback --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 execute massage-feedback --remote --file=migrations/0001_init.sql",
    "db:seed:local": "wrangler d1 execute massage-feedback --local --file=migrations/0002_seed.sql",
    "db:export": "wrangler d1 export massage-feedback --remote --output=backup.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8",
    "wrangler": "^4.151.3"
  }
}
