# Copy to .env for local runs. Never commit real values.
PORT=8787
# Passphrase for /admin in local dev. In production this is replaced by Cloudflare Access.
ADMIN_TOKEN=change-me
# Salt for hashing visitor IPs. Generate a fresh one: openssl rand -hex 32
IP_SALT=change-me
# Turnstile: leave empty to disable locally. Cloudflare test keys always pass.
# site key  1x00000000000000000000AA
# secret    1x0000000000000000000000000000000AA
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Published feedback per connection per hour. The plan says 3; the demo uses 10.
RATE_LIMIT_MAX=3
