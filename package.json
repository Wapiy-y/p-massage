{
  "name": "p-massage",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile-first feedback site for an independent massage therapist \u2014 Cloudflare Worker, Hono, D1",
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm test",
    "test": "vitest run",
    "db:migrate:local": "wrangler d1 execute massage-feedback --local --file=migrations/0001_init.sql",
    "db:migrate:remote": "wrangler d1 migrations apply massage-feedback --remote",
    "db:seed:local": "wrangler d1 execute massage-feedback --local --file=migrations/0002_seed.sql",
    "db:export": "wrangler d1 export massage-feedback --remote --output=backup.sql"
  },
  "dependencies": {
    "hono": "^4.6.14"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261022.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.72.0",
    "vitest": "^2.1.8",
    "wrangler": "^4.151.3"
  }
}
